/* =========================================================
 * MediPortal Healthcare Application Stylesheet
 * Theme: Apple-Inspired Clean Design
 * Font: SF Pro Display (fallback to system fonts)
 * ========================================================= */

/* --- CSS Reset & Base Styles --- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* --- Color Variables --- */
:root {
  --color-navy: #1c2e4a;
  --color-teal: #0071e3;
  --color-blue-light: #e8f4ff;
  --color-text-dark: #1d1d1f;
  --color-text-light: #6e6e73;
  --color-background: #f5f5f7;
  --color-white: #ffffff;
  --color-success: #34c759;
  --color-error: #ff3b30;
  --font-family-base: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

/* --- General Typography --- */
body {
  margin: 0;
  font-family: var(--font-family-base);
  background: var(--color-white);
  color: var(--color-text-dark);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  color: var(--color-text-dark);
  margin-top: 0;
  font-weight: 600;
  letter-spacing: -0.02em;
}

/* --- Navbar --- */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 12px 5%;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.navbar .logo {
  font-weight: 600;
  font-size: 1.3rem;
  color: var(--color-text-dark);
  display: flex;
  align-items: center;
  gap: 8px;
}

.navbar .logo i {
  color: var(--color-teal);
  font-size: 1.5rem;
}

.navbar .logo-sub {
  font-size: 0.7rem;
  font-weight: 400;
  color: var(--color-text-light);
  margin-left: 4px;
}

.navbar nav {
  display: flex;
  align-items: center;
  gap: 8px;
}

.navbar nav a {
  color: var(--color-text-dark);
  text-decoration: none;
  font-weight: 400;
  font-size: 0.875rem;
  padding: 8px 16px;
  border-radius: 20px;
  transition: all 0.2s ease;
}

.navbar nav a:hover {
  background-color: rgba(0, 0, 0, 0.04);
}

/* --- Buttons --- */
.btn {
  padding: 10px 20px;
  border-radius: 24px;
  font-weight: 500;
  font-size: 0.875rem;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-primary {
  background: var(--color-teal);
  color: var(--color-white) !important;
}

.btn-primary:hover {
  background: #0077ed;
  transform: translateY(-1px);
}

.btn-text {
  background: transparent;
  color: var(--color-teal) !important;
}

.btn-text:hover {
  text-decoration: underline;
}

.btn-danger {
  background: var(--color-error);
  color: var(--color-white) !important;
}

/* --- Badge --- */
.badge {
  display: inline-block;
  background: rgba(0, 113, 227, 0.1);
  color: var(--color-teal);
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 500;
  margin-bottom: 20px;
  letter-spacing: 0.02em;
}

.badge-outline {
  display: inline-block;
  border: 1px solid var(--color-teal);
  color: var(--color-teal);
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* --- Hero Section --- */
.hero-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 80px 5% 60px;
  gap: 60px;
  background: linear-gradient(135deg, #f5f7fa 0%, #ffffff 100%);
}

.hero-text-block {
  flex: 1;
  max-width: 600px;
}

.hero-text-block h1 {
  font-size: 3.5rem;
  font-weight: 600;
  line-height: 1.1;
  margin-bottom: 20px;
  letter-spacing: -0.03em;
}

.highlight-blue {
  color: var(--color-teal);
}

.hero-text-block p {
  color: var(--color-text-light);
  font-size: 1.125rem;
  line-height: 1.6;
  margin-bottom: 30px;
  max-width: 540px;
}

.hero-buttons {
  display: flex;
  gap: 16px;
  margin-bottom: 40px;
}

.hero-stats {
  display: flex;
  gap: 32px;
  margin-top: 40px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stat-item i {
  color: var(--color-success);
  font-size: 1.5rem;
}

.stat-item div {
  font-size: 0.875rem;
  line-height: 1.4;
}

.stat-item strong {
  font-weight: 600;
  color: var(--color-text-dark);
}

.hero-image-block {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image-block img {
  width: 200%;
  max-width: 800px;
  border-radius: 5px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
}

/* --- Solutions Section --- */
.solutions {
  padding: 80px 5%;
  background: var(--color-white);
}

.section-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px;
}

.section-header h2 {
  font-size: 2.5rem;
  font-weight: 600;
  margin: 16px 0;
  letter-spacing: -0.02em;
}

.section-header p {
  color: var(--color-text-light);
  font-size: 1.125rem;
  line-height: 1.6;
}

.solutions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}

.solution-card {
  background: var(--color-white);
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 16px;
  padding: 32px;
  transition: all 0.3s ease;
}

.solution-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  border-color: rgba(0, 113, 227, 0.2);
}

.icon-box {
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, rgba(0, 113, 227, 0.1), rgba(0, 113, 227, 0.05));
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.icon-box i {
  font-size: 1.5rem;
  color: var(--color-teal);
}

.solution-card h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 12px;
  color: var(--color-text-dark);
}

.solution-card p {
  color: var(--color-text-light);
  font-size: 0.9375rem;
  line-height: 1.6;
}

/* --- Stats Banner --- */
.stats-banner {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 60px 5%;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8f4ff 100%);
  gap: 40px;
  flex-wrap: wrap;
}

.stat-box {
  text-align: center;
}

.stat-box h3 {
  font-size: 3rem;
  font-weight: 700;
  color: var(--color-teal);
  margin-bottom: 8px;
  letter-spacing: -0.02em;
}

.stat-box p {
  font-size: 1rem;
  color: var(--color-text-light);
  font-weight: 500;
}

/* --- Footer --- */
footer {
  background: var(--color-navy);
  color: var(--color-white);
  padding: 60px 5% 30px;
}

.footer-content {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto 40px;
}

.footer-col h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 16px;
  color: var(--color-white);
}

.footer-col p {
  font-size: 0.875rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12px;
}

.footer-col ul {
  list-style: none;
  padding: 0;
}

.footer-col ul li {
  margin-bottom: 10px;
}

.footer-col ul li a {
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  font-size: 0.875rem;
  transition: color 0.2s;
}

.footer-col ul li a:hover {
  color: var(--color-white);
}

.newsletter {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
}

.newsletter input {
  flex: 1;
  padding: 10px 16px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--color-white);
  font-size: 0.875rem;
}

.newsletter input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.newsletter button {
  padding: 10px 20px;
  background: var(--color-teal);
  color: var(--color-white);
  border: none;
  border-radius: 8px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s;
}

.newsletter button:hover {
  background: #0077ed;
}

.contact-info {
  margin-top: 16px;
}

.contact-info p {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  margin-bottom: 8px;
}

.contact-info i {
  color: var(--color-teal);
  font-size: 0.875rem;
}

.footer-bottom {
  text-align: center;
  padding-top: 30px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-bottom p {
  font-size: 0.8125rem;
  color: rgba(255, 255, 255, 0.5);
}

/* --- Responsive Design --- */
@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    gap: 12px;
  }

  .navbar nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-split {
    flex-direction: column-reverse;
    padding: 40px 5%;
  }

  .hero-text-block h1 {
    font-size: 2.5rem;
  }

  .hero-stats {
    flex-direction: column;
    gap: 16px;
  }

  .solutions-grid {
    grid-template-columns: 1fr;
  }

  .stats-banner {
    flex-direction: column;
    gap: 32px;
  }

  .footer-content {
    grid-template-columns: 1fr;
  }
}

/* --- Legacy Styles (for other pages) --- */
.features {
  text-align: center;
  padding: 80px 5%;
  background: #ffffff;
}

.features h2 {
  font-size: 2em;
  color: var(--color-navy);
  margin-bottom: 50px;
}

.feature-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
}

.feature-card {
  background-color: #fff;
  width: 250px;
  border-radius: 20px;
  padding: 30px;
  text-align: center;
  border: 1px solid rgba(135, 151, 196, 0.2);
  box-shadow: 0 4px 20px rgba(61, 82, 160, 0.1);
  transition: 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 30px rgba(61, 82, 160, 0.25);
}

.feature-card img {
  width: 80px;
  height: 80px;
  object-fit: contain;
  margin: 0 auto 15px;
}

.feature-card h3 {
  color: var(--color-teal);
  margin-bottom: 10px;
}

.feature-card p {
  font-size: 0.95em;
}

/* --- Forms --- */
.content-section {
  max-width: 900px;
  margin: 50px auto;
  padding: 30px;
  background: white;
  border-radius: 15px;
  box-shadow: 0 10px 30px rgba(61, 82, 160, 0.15);
}

.form-group label {
  color: var(--color-teal);
  font-weight: 600;
}

input,
select,
textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 10px;
  transition: border-color 0.2s;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--color-teal);
  outline: none;
}

/* --- Tables --- */
table {
  width: 100%;
  border-spacing: 0 10px;
  margin-top: 15px;
}

th {
  background-color: var(--color-navy);
  color: #fff;
  padding: 15px;
  text-align: left;
}

td {
  padding: 15px;
}

tr:nth-child(even) {
  background-color: #f4f5fb;
}

tr:hover {
  background-color: #e8edff;
}

/* --- Status Tags --- */
.status-tag {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 15px;
  font-weight: 600;
  font-size: 0.8em;
}

.status-pending {
  background-color: #f1c40f;
  color: #333;
}

.status-checked_in {
  background-color: var(--color-teal);
  color: white;
}

.status-cancelled {
  background-color: var(--color-error);
  color: white;
}

/* --- Dashboard --- */
.dashboard-container {
  max-width: 1200px;
  margin: 50px auto;
  padding: 30px;
  background: white;
  border-radius: 15px;
  box-shadow: 0 10px 30px rgba(61, 82, 160, 0.1);
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 40px;
  justify-content: space-between;
}

.stat-card {
  flex: 1;
  min-width: 200px;
  padding: 20px;
  border-radius: 12px;
  color: white;
  box-shadow: 0 4px 10px rgba(61, 82, 160, 0.15);
}

.stat-card.blue {
  background: var(--color-navy);
}

.stat-card.green {
  background: var(--color-teal);
}

.stat-card.orange {
  background: #ff9f43;
}

.stat-card.red {
  background: var(--color-error);
}

/* --- Flash Messages --- */
.flash {
  padding: 15px 20px;
  margin: 10px;
  border-radius: 8px;
  font-weight: 500;
}

.flash.success {
  background: #d4edda;
  color: var(--color-success);
}

.flash.error {
  background: #f8d7da;
  color: var(--color-error);
}

.flash.info {
  background: #e2e3e5;
  color: #333;
}

/* --- Login/Register Page --- */
.login-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #eef7fe;
  font-family: var(--font-family-base);
}

.auth-card {
  background: white;
  padding: 40px;
  border-radius: 24px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  width: 100%;
  max-width: 420px;
  text-align: center;
  position: relative;
}

.auth-header {
  margin-bottom: 30px;
}

.logo-icon {
  width: 50px;
  height: 50px;
  margin-bottom: 15px;
  color: #0095f6;
}

.auth-header h2 {
  font-size: 24px;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8px;
}

.auth-header p {
  color: #8e8e8e;
  font-size: 14px;
  margin: 0;
}

.auth-toggle {
  background: #f1f3f6;
  border-radius: 12px;
  padding: 4px;
  display: flex;
  margin-bottom: 30px;
  position: relative;
}

.toggle-btn {
  flex: 1;
  border: none;
  background: transparent;
  padding: 10px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 2;
}

.toggle-btn.active {
  background: white;
  color: #1a1a1a;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.auth-form {
  display: none;
  text-align: left;
}

.auth-form.active {
  display: block;
  animation: fadeIn 0.3s ease;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #666;
  margin-bottom: 8px;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #e1e1e1;
  border-radius: 12px;
  font-size: 14px;
  color: #333;
  background: #fff;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #0095f6;
  outline: none;
}

.btn-auth {
  width: 100%;
  background: #0095f6;
  color: white;
  border: none;
  padding: 14px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: background 0.3s;
  margin-top: 10px;
}

